{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yurucommu",
  "version": "0.1.0",
  "identifier": "com.yurucommu",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yurucommu",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: https: http://ipc.localhost http://localhost:* http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": { "minSdkVersion": 28 }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["yurucommu"], "appLink": false }]
    }
  }
}
