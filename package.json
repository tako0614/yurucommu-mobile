{
  "name": "@takosjp/yurucommu-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "bootstrap": "bun install --cwd ../takosumi --frozen-lockfile && bun install --frozen-lockfile",
    "dev": "bunx vite --config vite.config.ts",
    "dev:web": "bun run dev",
    "build": "bunx vite build --config vite.config.ts",
    "build:web": "bun run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "mobile:check": "bun run check && bun test && bun run build",
    "mobile:doctor": "bun ../takosumi/mobile-kit/scripts/check-tauri-mobile.mjs --product yurucommu --scheme yurucommu --product-name Yurucommu --dev-port 1430 --remote-push-plugin mobile-push",
    "mobile:native-release-check": "bun ../takosumi/mobile-kit/scripts/check-tauri-mobile-release.mjs --product yurucommu --scheme yurucommu --product-name Yurucommu --dev-port 1430 --remote-push-plugin mobile-push",
    "mobile:release-evidence-check": "bun ../takosumi/mobile-kit/scripts/check-mobile-release-evidence.mjs --product yurucommu --product-name Yurucommu --bundle-id com.yurucommu",
    "mobile:release-status": "bun ../takosumi/mobile-kit/scripts/report-mobile-release-status.mjs --product yurucommu --product-name Yurucommu --bundle-id com.yurucommu --require-secure-keystore --require-remote-push --remote-push-backend-file ../yurucommu-core/src/backend/lib/notification-push.ts",
    "tauri:dev": "bunx tauri dev",
    "tauri:build": "bunx tauri build",
    "tauri:android:init": "bun ../takosumi/mobile-kit/scripts/init-tauri-mobile-native.mjs --platform android --apple-environment development",
    "tauri:native-push:apply": "bun ../takosumi/mobile-kit/scripts/apply-tauri-mobile-push-native.mjs --apple-environment development",
    "tauri:native-push:verify": "bun ../takosumi/mobile-kit/scripts/apply-tauri-mobile-push-native.mjs --apple-environment development --dry-run --strict",
    "tauri:native-push:apply:release": "bun ../takosumi/mobile-kit/scripts/apply-tauri-mobile-push-native.mjs --apple-environment production",
    "tauri:native-push:verify:release": "bun ../takosumi/mobile-kit/scripts/apply-tauri-mobile-push-native.mjs --apple-environment production --dry-run --strict",
    "tauri:ios:init": "bun ../takosumi/mobile-kit/scripts/init-tauri-mobile-native.mjs --platform ios --apple-environment development"
  },
  "dependencies": {
    "@takosjp/takosumi-mobile-kit": "file:../takosumi/mobile-kit",
    "takosumi-contract": "file:../takosumi/contract",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  }
}
